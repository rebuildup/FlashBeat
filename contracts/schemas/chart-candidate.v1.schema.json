{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlashBeat Chart Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "songId",
    "chartId",
    "difficulty",
    "level",
    "scoringVersion",
    "playback",
    "syncOffsetMs",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "songId": {
      "$ref": "./chart-revision.v1.schema.json#/$defs/id"
    },
    "chartId": {
      "$ref": "./chart-revision.v1.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "easy",
        "normal",
        "hard",
        "expert"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "scoringVersion": {
      "const": "fb-tap-v1"
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "videoId"
      ],
      "properties": {
        "provider": {
          "const": "youtube"
        },
        "videoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        }
      }
    },
    "syncOffsetMs": {
      "type": "integer",
      "minimum": -30000,
      "maximum": 30000
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timeMs",
          "lane",
          "type"
        ],
        "properties": {
          "timeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1800000
          },
          "lane": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "type": {
            "const": "tap"
          }
        }
      }
    },
    "lyrics": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startMs",
          "endMs",
          "text"
        ],
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "furigana": {
            "type": "string",
            "maxLength": 400
          },
          "romaji": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    }
  }
}
