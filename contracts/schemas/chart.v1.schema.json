{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlashBeat Legacy-Compatible Chart v1",
  "description": "Same JSON shape as Assets/Game/Resources/<song>.json; no new chart DSL before festival.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "maxBlock",
    "BPM",
    "offset",
    "notes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "maxBlock": {
      "type": "integer",
      "description": "Number of lanes the chart uses. The editor always writes 8; the legacy charts carry 5 as well, so the contract accepts 1 to 8.",
      "minimum": 1,
      "maximum": 8
    },
    "BPM": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "offset": {
      "type": "integer",
      "description": "Legacy field: preserve value. Do not silently reinterpret as milliseconds."
    },
    "notes": {
      "type": "array",
      "description": "The legacy charts carry empty note lists (the probe chart and ニセモノ), so an empty chart is a valid chart.",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "type",
          "num",
          "block",
          "LPB"
        ],
        "properties": {
          "type": {
            "type": "integer",
            "description": "Note kind. 1 = Tap (the only kind the charts shipped before issue #164 carry), 2 = Hold (a long note that is held down).",
            "enum": [
              1,
              2
            ]
          },
          "num": {
            "type": "integer",
            "description": "Line index of the note. For a Tap it is the hit position, for a Hold it is the start of the hold.",
            "minimum": 0
          },
          "block": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "LPB": {
            "type": "integer",
            "minimum": 1,
            "maximum": 192
          },
          "endNum": {
            "type": "integer",
            "description": "Line index where a Hold ends. Required for type 2 and ignored for type 1. The hold covers the lines (num, endNum] at the resolution of LPB.",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": 2
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "endNum"
              ]
            }
          }
        ]
      }
    },
    "lyrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "startTime": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "endTime": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "furigana": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mondai": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "romaji": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
