#!/usr/bin/env bash
# script/with-secrets — inject the FlashBeat Infisical secret set into one process.
#
#   script/with-secrets command [args...]
#
# Same contract as ~/.dotfiles/script/with-secrets, but bound to the FlashBeat
# Infisical project instead of the dotfiles project. Non-secret instance
# metadata comes from config/infisical.sh, the tracked project binding must
# match it, and the self-hosted endpoint is pinned explicitly so the CLI can
# never fall back to Infisical Cloud.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../config/infisical.sh
source "$repo_root/config/infisical.sh"

if [[ "$#" -lt 1 ]]; then
  printf 'usage: %s command [args...]\n' "$0" >&2
  exit 2
fi

if ! command -v infisical >/dev/null 2>&1; then
  printf 'missing required command: infisical\n' >&2
  exit 1
fi

if [[ ! -f "$repo_root/.infisical.json" ]]; then
  printf 'missing tracked Infisical project binding: %s/.infisical.json\n' "$repo_root" >&2
  exit 1
fi

if ! grep -Eq "\"workspaceId\"[[:space:]]*:[[:space:]]*\"$INFISICAL_PROJECT_ID\"" "$repo_root/.infisical.json"; then
  printf 'Infisical binding does not match expected self-host project %s\n' "$INFISICAL_PROJECT_ID" >&2
  exit 1
fi

exec infisical run "--projectId=$INFISICAL_PROJECT_ID" "--env=$INFISICAL_ENVIRONMENT" "--project-config-dir=$repo_root" -- "$@"
