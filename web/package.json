{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "node --test tests/*.test.ts tests/*.test.mjs && vitest run",
    "test:e2e:harness": "vitest run --config tests/e2e/vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e": "node tests/e2e/run.ts",
    "visual": "node tests/visual/capture.mjs",
    "codegen": "panda codegen",
    "postinstall": "void prepare && panda codegen"
  },
  "dependencies": {
    "@ark-ui/react": "5.40.0",
    "@cfworker/json-schema": "^4.1.6",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "ajv": "^8.20.0",
    "hono": "^4.11.9",
    "konva": "^10.9.1",
    "lucide-react": "1.70.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@pandacss/types": "2.5.0",
    "@pandacss/vite": "2.5.0",
    "@park-ui/cli": "1.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.6.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "jsdom": "^31.0.0",
    "oxc-transform-react": "^0.152.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0",
    "vite-plus": "^1.4.0",
    "vitest": "^5.1.0",
    "void": "1.6.2",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "@park-ui/cli": {
      "typescript": "$typescript"
    },
    "vite": "$vite"
  }
}
