{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["void/env", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@styled-system": ["./styled-system"],
      "styled-system": ["./styled-system"],
      "styled-system/*": ["./styled-system/*"],
      "void/db": ["./.void/db.d.ts"],
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"],
      "void/routes": ["./.void/routes.d.ts"]
    }
  },
  "include": [
    "src",
    "pages",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db",
    "tests",
    "styled-system",
    // Generated by `void env types`: augments `void/env` with the typed
    // `env.FLASHBEAT_ADMIN_TOKEN` access used by the publish endpoint.
    ".void/env.d.ts"
  ]
}
